FROM ghcr.io/astral-sh/uv:0.13.6 AS uv

FROM debian:trixie-slim

# Install PostgreSQL dev libraries and required packages
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app
ENV UV_PYTHON_INSTALL_DIR=/python UV_PYTHON_PREFERENCE=only-managed

# Install Python
COPY .python-version ./
RUN --mount=from=uv,source=/uv,target=/bin/uv uv python install

# Install required packages
COPY pyproject.toml uv.lock ./
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    uv sync --locked --no-cache --extra mysql
ENV PATH="/app/.venv/bin:$PATH"

# Copy validation scripts
COPY database_functions/ /app/database_functions/
COPY validate_db.py /app/

# Non-secret defaults for the throwaway CI test database. Overridable at build time
# (--build-arg) or runtime (-e); never used by the production image.
ARG DB_USER=postgres
ARG DB_PASSWORD=test_password_123
ENV DB_TYPE=postgresql
ENV DB_HOST=postgres_db
ENV DB_PORT=5432
ENV DB_USER=${DB_USER}
ENV DB_PASSWORD=${DB_PASSWORD}
ENV DB_NAME=pinepods_database

# Run validator
CMD ["python", "validate_db.py", "--verbose"]